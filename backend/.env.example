# ============================================================
# Supabase
# ============================================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ============================================================
# Servidor
# ============================================================
PORT=3001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
NODE_ENV=development

# ============================================================
# Stripe (tarjetas de crédito/débito/prepagadas)
# Obtener en: https://dashboard.stripe.com/apikeys
# ============================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================
# PayPal
# Obtener en: https://developer.paypal.com/dashboard/
# ============================================================
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_MODE=sandbox
# sandbox para pruebas, live para producción

# ============================================================
# Binance Pay
# Obtener en: https://merchant.binance.com/
# ============================================================
BINANCE_API_KEY=...
BINANCE_SECRET_KEY=...
BINANCE_MERCHANT_ID=...
